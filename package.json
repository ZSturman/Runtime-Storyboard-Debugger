{
  "name": "runtime-storyboard-debugger",
  "version": "0.2.0",
  "private": true,
  "description": "Turn software behavior into a navigable causal story for debugging and codebase comprehension.",
  "license": "MIT",
  "author": "Zachary Sturman",
  "homepage": "https://github.com/ZSturman/Runtime-Storyboard-Debugger#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZSturman/Runtime-Storyboard-Debugger.git"
  },
  "bugs": {
    "url": "https://github.com/ZSturman/Runtime-Storyboard-Debugger/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "debugger",
    "tracing",
    "instrumentation",
    "code-comprehension",
    "onboarding",
    "storyboard",
    "ast",
    "babel",
    "developer-tools"
  ],
  "workspaces": [
    "packages/core",
    "packages/ui",
    "examples/order-api"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:ui",
    "build:core": "npm run build -w packages/core",
    "build:ui": "npm run build -w packages/ui",
    "dev": "concurrently -n core,ui -c blue,green \"npm run dev:core\" \"npm run dev:ui\"",
    "dev:core": "npm run dev -w packages/core -- analyze examples/order-api",
    "dev:ui": "npm run dev -w packages/ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/ui/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
